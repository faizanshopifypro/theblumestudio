{% doc %}
  Product customizer for embroidered boards. Preview, options, and line-item properties.

  @param {object} block - Board customizer section block
  @param {object} product - Current product
  @param {string} product_form_id - Product form id the inputs submit with
  @param {object} section - Parent section

  @example
  {% render 'board-customizer', block: block, product: product, product_form_id: product_form_id, section: section %}
{% enddoc %}

{{ 'board-customizer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'board-customizer.js' | asset_url }}" defer="defer"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora&family=PT+Serif&family=Parisienne&family=Pinyon+Script&display=swap">

{%- liquid
  assign vertical_blank = 'https://theblumestudio.com/cdn/shop/files/87E96109-B415-46D5-A96B-23F18B30142E.png'
  assign horizontal_blank = 'https://theblumestudio.com/cdn/shop/files/B00A42E0-7172-4022-90FE-5C2751CFF0F6.png'
  assign keep_blank_preview = false
  if block.settings.vertical_image != blank
    assign vertical_blank = block.settings.vertical_image | image_url: width: 1600
    assign keep_blank_preview = true
  else
    for media in product.media
      assign media_src = media.preview_image.src | default: ''
      if media_src contains '87E96109-B415-46D5-A96B-23F18B30142E' or media_src contains 'B00A42E0-7172-4022-90FE-5C2751CFF0F6'
        assign keep_blank_preview = true
      endif
      if media_src contains '87E96109-B415-46D5-A96B-23F18B30142E'
        assign vertical_blank = media.preview_image | image_url: width: 1400
      endif
    endfor
    unless keep_blank_preview
      assign preview_media = product.featured_media | default: product.media.first
      if preview_media != blank
        assign vertical_blank = preview_media.preview_image | image_url: width: 1600
      endif
    endunless
  endif
  if block.settings.horizontal_image != blank
    assign horizontal_blank = block.settings.horizontal_image | image_url: width: 1800
  else
    for media in product.media
      assign media_src = media.preview_image.src | default: ''
      if media_src contains 'B00A42E0-7172-4022-90FE-5C2751CFF0F6'
        assign horizontal_blank = media.preview_image | image_url: width: 1400
      endif
    endfor
  endif

  assign font_lines = block.settings.fonts | newline_to_br | split: '<br />'
  assign date_font_lines = block.settings.date_fonts | newline_to_br | split: '<br />'
  assign color_lines = block.settings.colors | newline_to_br | split: '<br />'
  assign occasion_lines = block.settings.occasions | newline_to_br | split: '<br />'
-%}

<style>
  {%- for line in font_lines -%}
    {%- liquid
      assign font_line = line | strip
      assign font_label = font_line
      assign font_source = font_line
      if font_line contains '|'
        assign font_parts = font_line | split: '|'
        assign font_label = font_parts[0] | strip
        assign font_source = font_parts[1] | strip
      endif
    -%}
    {%- if font_source contains '.woff2' and font_label != blank -%}
      @font-face {
        font-family: {{ font_label | json }};
        src: url('{{ font_source | asset_url }}') format('woff2');
        font-display: swap;
      }
    {%- endif -%}
  {%- endfor -%}
  {%- for line in date_font_lines -%}
    {%- liquid
      assign font_line = line | strip
      assign font_label = font_line
      assign font_source = font_line
      if font_line contains '|'
        assign font_parts = font_line | split: '|'
        assign font_label = font_parts[0] | strip
        assign font_source = font_parts[1] | strip
      endif
    -%}
    {%- if font_source contains '.woff2' and font_label != blank -%}
      @font-face {
        font-family: {{ font_label | json }};
        src: url('{{ font_source | asset_url }}') format('woff2');
        font-display: swap;
      }
    {%- endif -%}
  {%- endfor -%}
</style>

<board-customizer
  class="board-customizer"
  data-vertical="{{ vertical_blank }}"
  data-horizontal="{{ horizontal_blank }}"
  {{ block.shopify_attributes }}
>
  <div class="board-customizer__preview">
    <div class="board-customizer__board" data-board data-orientation="vertical">
      <img
        class="board-customizer__image"
        data-board-image
        src="{{ vertical_blank }}"
        alt=""
        width="700"
        height="900"
      >
      <div class="board-customizer__stage" data-stage>
        <p class="board-customizer__piece" data-piece="name-1" data-x="50" data-y="18" data-size="100" dir="rtl"></p>
        <p class="board-customizer__piece" data-piece="name-2" data-x="50" data-y="36" data-size="100" dir="rtl"></p>
        <p class="board-customizer__piece" data-piece="additional" data-x="50" data-y="54" data-size="100" dir="auto" hidden></p>
        <p class="board-customizer__piece" data-piece="english" data-x="50" data-y="70" data-size="30" dir="ltr" hidden></p>
        <div class="board-customizer__signature" data-signature></div>
      </div>
    </div>
  </div>

  <div class="board-customizer__field">
    <label class="board-customizer__label" for="BoardOccasion-{{ section.id }}">Occasion</label>
    <div class="select">
      <select
        id="BoardOccasion-{{ section.id }}"
        class="select__select"
        name="properties[Occasion]"
        form="{{ product_form_id }}"
      >
        {%- for line in occasion_lines -%}
          {%- assign occasion = line | strip -%}
          {%- if occasion != blank -%}
            <option value="{{ occasion | escape }}">{{ occasion | escape }}</option>
          {%- endif -%}
        {%- endfor -%}
      </select>
      <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
    </div>
  </div>

  <fieldset class="board-customizer__field">
    <legend class="board-customizer__label">Board orientation</legend>
    <div class="board-customizer__choices">
      <label class="board-customizer__choice">
        <input
          type="radio"
          name="properties[Orientation]"
          value="Vertical"
          form="{{ product_form_id }}"
          data-orientation-input
          checked
        >
        <span>Vertical</span>
      </label>
      <label class="board-customizer__choice">
        <input
          type="radio"
          name="properties[Orientation]"
          value="Horizontal"
          form="{{ product_form_id }}"
          data-orientation-input
        >
        <span>Horizontal</span>
      </label>
    </div>
  </fieldset>

  <fieldset class="board-customizer__field">
    <legend class="board-customizer__label">Bead embroidery color</legend>
    <div class="board-customizer__swatches">
      {%- assign color_index = 0 -%}
      {%- for line in color_lines -%}
        {%- liquid
          assign color_parts = line | split: '|'
          assign color_letter = ''
          assign color_name = ''
          assign color_hex = ''
          if color_parts.size >= 3
            assign color_letter = color_parts[0] | strip
            assign color_name = color_parts[1] | strip
            assign color_hex = color_parts[2] | strip
          elsif color_parts.size == 2
            assign color_name = color_parts[0] | strip
            assign color_hex = color_parts[1] | strip
          endif
        -%}
        {%- if color_name != blank and color_hex != blank -%}
          {%- assign color_index = color_index | plus: 1 -%}
          {%- capture color_value -%}{% if color_letter != blank %}{{ color_letter }} {% endif %}{{ color_name }}{%- endcapture -%}
          <label class="board-swatch">
            <input
              type="radio"
              name="properties[Bead embroidery color]"
              value="{{ color_value | strip | escape }}"
              form="{{ product_form_id }}"
              data-color-input
              data-color="{{ color_hex | escape }}"
              {% if color_index == 1 %}
                checked
              {% endif %}
            >
            <span class="board-swatch__chip" style="background: {{ color_hex }};">{{ color_letter }}</span>
            <span class="board-swatch__name">{{ color_name | escape }}</span>
          </label>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <p class="board-customizer__hint">Please refer to the color chart in the image when selecting your bead color.</p>
  </fieldset>

  <div class="board-customizer__field">
    <label class="board-customizer__label" for="BoardName1-{{ section.id }}">Name 1</label>
    <input
      id="BoardName1-{{ section.id }}"
      class="board-customizer__input"
      type="text"
      name="properties[Name 1]"
      form="{{ product_form_id }}"
      required
      dir="auto"
      data-piece-input="name-1"
      placeholder="عبدالله"
    >
    <label class="board-customizer__size" for="BoardName1Size-{{ section.id }}">
      Size
      <input id="BoardName1Size-{{ section.id }}" type="range" min="70" max="160" value="100" data-piece-size="name-1">
    </label>
  </div>

  <div class="board-customizer__field">
    <label class="board-customizer__label" for="BoardName2-{{ section.id }}">Name 2</label>
    <input
      id="BoardName2-{{ section.id }}"
      class="board-customizer__input"
      type="text"
      name="properties[Name 2]"
      form="{{ product_form_id }}"
      dir="auto"
      data-piece-input="name-2"
      placeholder="موزة"
    >
    <label class="board-customizer__size" for="BoardName2Size-{{ section.id }}">
      Size
      <input id="BoardName2Size-{{ section.id }}" type="range" min="70" max="160" value="100" data-piece-size="name-2">
    </label>
  </div>

  <div class="board-customizer__field">
    <label class="board-customizer__label" for="BoardAdditional-{{ section.id }}">Additional Text</label>
    <input
      id="BoardAdditional-{{ section.id }}"
      class="board-customizer__input"
      type="text"
      name="properties[Additional Text]"
      form="{{ product_form_id }}"
      dir="auto"
      data-piece-input="additional"
    >
    <label class="board-customizer__size" for="BoardAdditionalSize-{{ section.id }}">
      Size
      <input id="BoardAdditionalSize-{{ section.id }}" type="range" min="70" max="160" value="100" data-piece-size="additional">
    </label>
  </div>

  <p class="board-customizer__hint">Drag each line on the preview to place it, then set its size.</p>

  <fieldset class="board-customizer__field">
    <legend class="board-customizer__label">Font for the Names</legend>
    <div class="board-customizer__choices board-customizer__choices--stack">
      {%- assign font_index = 0 -%}
      {%- for line in font_lines -%}
        {%- liquid
          assign font_line = line | strip
          assign font_label = font_line
          assign font_source = font_line
          assign font_css = ''
          if font_line contains '|'
            assign font_parts = font_line | split: '|'
            assign font_label = font_parts[0] | strip
            assign font_source = font_parts[1] | strip
          endif
          if font_source contains '.woff2'
            assign font_css = font_label | prepend: "'" | append: "', serif"
          elsif font_label == 'Trirong'
            assign font_css = 'var(--font-heading-family)'
          elsif font_label == 'Quattrocento Sans'
            assign font_css = 'var(--font-body-family)'
          elsif font_label == 'Pinyon Script' or font_label == 'Parisienne'
            assign font_css = font_label | prepend: "'" | append: "', cursive"
          elsif font_label == 'PT Serif' or font_label == 'Lora'
            assign font_css = font_label | prepend: "'" | append: "', serif"
          endif
        -%}
        {%- if font_css != blank -%}
          {%- assign font_index = font_index | plus: 1 -%}
          <label class="board-customizer__choice">
            <input
              type="radio"
              name="properties[Font for the Names]"
              value="{{ font_label | escape }}"
              form="{{ product_form_id }}"
              data-font-input
              data-font-family="{{ font_css | escape }}"
              {% if font_index == 1 %}
                checked
              {% endif %}
            >
            <span style="font-family: {{ font_css }};">{{ font_label | escape }}</span>
          </label>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </fieldset>

  <div class="board-customizer__field">
    <label class="board-customizer__label" for="BoardDate-{{ section.id }}">Event date</label>
    <input
      id="BoardDate-{{ section.id }}"
      class="board-customizer__input"
      type="date"
      name="properties[Event date]"
      form="{{ product_form_id }}"
      required
      data-date-input
    >
    <p class="board-customizer__hint">Place the order 7–10 days before the event date.</p>
  </div>

  <input type="hidden" name="properties[Name 1 place]" form="{{ product_form_id }}" data-piece-place="name-1" value="x:50 y:18 size:100">
  <input type="hidden" name="properties[Name 2 place]" form="{{ product_form_id }}" data-piece-place="name-2" value="x:50 y:36 size:100" disabled>
  <input type="hidden" name="properties[Additional Text place]" form="{{ product_form_id }}" data-piece-place="additional" value="x:50 y:54 size:100" disabled>
  <input type="hidden" name="properties[Date place]" form="{{ product_form_id }}" data-piece-place="english" value="x:50 y:70 size:30" disabled>

  <fieldset class="board-customizer__field">
    <legend class="board-customizer__label">Include date on the board</legend>
    <div class="board-customizer__choices">
      <label class="board-customizer__choice">
        <input
          type="radio"
          name="properties[Include date]"
          value="No"
          form="{{ product_form_id }}"
          data-include-input
          checked
        >
        <span>No</span>
      </label>
      <label class="board-customizer__choice">
        <input
          type="radio"
          name="properties[Include date]"
          value="Yes"
          form="{{ product_form_id }}"
          data-include-input
        >
        <span>Yes</span>
      </label>
    </div>
  </fieldset>

  <fieldset class="board-customizer__field">
    <legend class="board-customizer__label">Rush Fee</legend>
    <div class="board-customizer__choices">
      <label class="board-customizer__choice">
        <input
          type="radio"
          name="properties[Rush Fee]"
          value="No"
          form="{{ product_form_id }}"
          data-rush-input
          checked
        >
        <span>No</span>
      </label>
      <label class="board-customizer__choice">
        <input
          type="radio"
          name="properties[Rush Fee]"
          value="Yes"
          form="{{ product_form_id }}"
          data-rush-input
        >
        <span>Yes</span>
      </label>
    </div>
    <p class="board-customizer__hint">Rush fee for 5 days: 60 QAR.</p>
  </fieldset>

  <div data-typed-date hidden>
    <div class="board-customizer__field">
      <label class="board-customizer__label" for="BoardTypedDate-{{ section.id }}">Date</label>
      <input
        id="BoardTypedDate-{{ section.id }}"
        class="board-customizer__input"
        type="text"
        name="properties[Date]"
        form="{{ product_form_id }}"
        data-piece-input="english"
        disabled
      >
      <p class="board-customizer__hint">Choose your preferred font and enter the date exactly as you’d like it to appear on your board.</p>
      <label class="board-customizer__size" for="BoardTypedDateSize-{{ section.id }}">
        Size
        <input id="BoardTypedDateSize-{{ section.id }}" type="range" min="30" max="160" value="30" data-piece-size="english" disabled>
      </label>
    </div>

    <fieldset class="board-customizer__field">
      <legend class="board-customizer__label">Date Font</legend>
      <div class="board-customizer__choices board-customizer__choices--stack">
        {%- assign date_font_index = 0 -%}
        {%- for line in date_font_lines -%}
          {%- liquid
            assign font_line = line | strip
            assign font_label = font_line
            assign font_source = font_line
            assign font_css = ''
            if font_line contains '|'
              assign font_parts = font_line | split: '|'
              assign font_label = font_parts[0] | strip
              assign font_source = font_parts[1] | strip
            endif
            if font_source contains '.woff2'
              assign font_css = font_label | prepend: "'" | append: "', serif"
            elsif font_label == 'Trirong'
              assign font_css = 'var(--font-heading-family)'
            elsif font_label == 'Quattrocento Sans'
              assign font_css = 'var(--font-body-family)'
            elsif font_label == 'Pinyon Script' or font_label == 'Parisienne'
              assign font_css = font_label | prepend: "'" | append: "', cursive"
            elsif font_label == 'PT Serif' or font_label == 'Lora'
              assign font_css = font_label | prepend: "'" | append: "', serif"
            endif
          -%}
          {%- if font_css != blank -%}
            {%- assign date_font_index = date_font_index | plus: 1 -%}
            <label class="board-customizer__choice">
              <input
                type="radio"
                name="properties[Date Font]"
                value="{{ font_label | escape }}"
                form="{{ product_form_id }}"
                data-english-font
                data-font-family="{{ font_css | escape }}"
                {% if date_font_index == 1 %}
                  checked
                {% endif %}
                disabled
              >
              <span style="font-family: {{ font_css }};">{{ font_label | escape }}</span>
            </label>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </fieldset>
  </div>

  <input
    type="hidden"
    name="properties[Date on board]"
    form="{{ product_form_id }}"
    value=""
    data-date-output
    disabled
  >

  <div class="board-customizer__field">
    <label class="board-customizer__label" for="BoardNotes-{{ section.id }}">Additional details</label>
    <textarea
      id="BoardNotes-{{ section.id }}"
      class="board-customizer__textarea"
      name="properties[Additional details]"
      form="{{ product_form_id }}"
      rows="3"
    ></textarea>
  </div>

  <div class="board-customizer__field">
    <label class="board-customizer__label" for="BoardDesign-{{ section.id }}">Upload your design</label>
    <input
      id="BoardDesign-{{ section.id }}"
      class="board-customizer__file"
      type="file"
      name="properties[Design]"
      form="{{ product_form_id }}"
      accept="image/png,image/jpeg,image/webp,application/pdf"
    >
  </div>
</board-customizer>
